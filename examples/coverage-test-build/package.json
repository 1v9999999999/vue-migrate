    "ant-design-vue": "^4.0.0",
    "@ant-design/icons-vue": "^7.0.0",
    "vxe-table": "^4.5.0",
    "xe-utils": "^3.5.4",
    "sortablejs": "^1.15.0",
    "wangeditor": "^4.7.15",
    "echarts": "^5.5.0",
    "axios": "^1.6.0",
    "mitt": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0",
    "typescript": "^5.3.0",
    "sass": "^1.77.0",
    "less": "^4.2.0",
    "stylus": "^0.60.0",
