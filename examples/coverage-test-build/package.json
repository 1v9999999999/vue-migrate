{
  "name": "vue-migrate-coverage-test-build",
  "version": "1.0.0",
  "private": true,
  "description": "Build verification for coverage-test/ — minimal Vite + Vue 3 + plugin deps to confirm .vue / .scss / .less / .styl compile without errors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
