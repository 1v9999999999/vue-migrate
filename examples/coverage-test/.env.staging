# staging (预发) 环境
NODE_ENV=production
VUE_APP_ENV=staging
VUE_APP_TITLE=Vue2 覆盖率测试项目 (预发)
VUE_APP_BASE_URL=https://staging.example.com/

# API
VUE_APP_API_BASE=https://staging-api.example.com/api
VUE_APP_API_VERSION=v1
VUE_APP_UPLOAD_BASE=https://staging-upload.example.com/upload
VUE_APP_UPLOAD_URL=https://staging-upload.example.com/api/upload

# WS
VUE_APP_WS_URL=wss://staging-ws.example.com/ws

# 第三方服务
VUE_APP_GA_ID=G-STAGING-XXXXX
VUE_APP_SENTRY_DSN=https://yyy@sentry.io/456
VUE_APP_BAIDU_MAP_AK=staging-key
VUE_APP_AMAP_AK=staging-key

# 调试 (预发开 vconsole, 方便排查)
VUE_APP_DEBUG=true
VUE_APP_LOG_LEVEL=info
VUE_APP_SHOW_ERROR=true
VUE_APP_PERFORMANCE=true
VUE_APP_VCONSOLE=true
VUE_APP_ERUDA=false

# 业务开关
VUE_APP_USE_MOCK=false
VUE_APP_USE_CDN=true
VUE_APP_USE_NEW_FEATURE=true
VUE_APP_SHOW_EXPERIMENTAL=true

# 端口
VUE_APP_PORT=8081
VUE_APP_OUTPUT_DIR=dist-staging

# 接口超时
VUE_APP_API_TIMEOUT=20000
VUE_APP_UPLOAD_TIMEOUT=90000
