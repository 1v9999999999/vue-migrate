# development 环境
NODE_ENV=development
VUE_APP_ENV=development
VUE_APP_TITLE=Vue2 覆盖率测试项目 (开发)
VUE_APP_BASE_URL=/

# API
VUE_APP_API_BASE=/api
VUE_APP_API_VERSION=v1
VUE_APP_PROXY_TARGET=http://localhost:3000
VUE_APP_UPLOAD_BASE=/upload
VUE_APP_UPLOAD_URL=http://localhost:3001/upload

# WS
VUE_APP_WS_URL=ws://localhost:3000/ws

# 第三方服务
VUE_APP_GA_ID=G-DEV-XXXXX
VUE_APP_SENTRY_DSN=
VUE_APP_BAIDU_MAP_AK=dev-key
VUE_APP_AMAP_AK=dev-key

# 调试
VUE_APP_DEBUG=true
VUE_APP_LOG_LEVEL=debug
VUE_APP_SHOW_ERROR=true
VUE_APP_PERFORMANCE=true
VUE_APP_VCONSOLE=true
VUE_APP_ERUDA=true

# 业务开关
VUE_APP_USE_MOCK=true
VUE_APP_USE_CDN=false
VUE_APP_USE_NEW_FEATURE=true
VUE_APP_SHOW_EXPERIMENTAL=true

# 端口
VUE_APP_PORT=8080
VUE_APP_OUTPUT_DIR=dist-dev

# 接口超时
VUE_APP_API_TIMEOUT=30000
VUE_APP_UPLOAD_TIMEOUT=60000
