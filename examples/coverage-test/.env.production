# production 环境
NODE_ENV=production
VUE_APP_ENV=production
VUE_APP_TITLE=Vue2 覆盖率测试项目
VUE_APP_BASE_URL=https://app.example.com/

# API
VUE_APP_API_BASE=https://api.example.com/api
VUE_APP_API_VERSION=v1
VUE_APP_UPLOAD_BASE=https://upload.example.com/upload
VUE_APP_UPLOAD_URL=https://upload.example.com/api/upload

# WS
VUE_APP_WS_URL=wss://ws.example.com/ws

# 第三方服务
VUE_APP_GA_ID=G-PROD-XXXXX
VUE_APP_SENTRY_DSN=https://xxx@sentry.io/123
VUE_APP_BAIDU_MAP_AK=prod-key
VUE_APP_AMAP_AK=prod-key

# 调试
VUE_APP_DEBUG=false
VUE_APP_LOG_LEVEL=error
VUE_APP_SHOW_ERROR=false
VUE_APP_PERFORMANCE=false
VUE_APP_VCONSOLE=false
VUE_APP_ERUDA=false

# 业务开关
VUE_APP_USE_MOCK=false
VUE_APP_USE_CDN=true
VUE_APP_USE_NEW_FEATURE=true
VUE_APP_SHOW_EXPERIMENTAL=false

# 端口 (生产环境无意义, 仅供 build 流程)
VUE_APP_PORT=8080
VUE_APP_OUTPUT_DIR=dist

# 接口超时
VUE_APP_API_TIMEOUT=15000
VUE_APP_UPLOAD_TIMEOUT=120000
