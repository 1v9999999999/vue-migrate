# test (单元测试) 环境
NODE_ENV=test
VUE_APP_ENV=test
VUE_APP_TITLE=Vue2 覆盖率测试项目 (测试)
VUE_APP_BASE_URL=/

# API (测试用 mock server)
VUE_APP_API_BASE=/api
VUE_APP_API_VERSION=v1
VUE_APP_UPLOAD_BASE=/upload
VUE_APP_UPLOAD_URL=/api/upload

# 调试
VUE_APP_DEBUG=true
VUE_APP_LOG_LEVEL=warn
VUE_APP_SHOW_ERROR=true
VUE_APP_PERFORMANCE=false
VUE_APP_VCONSOLE=false
VUE_APP_ERUDA=false

# 业务开关
VUE_APP_USE_MOCK=true
VUE_APP_USE_CDN=false
VUE_APP_USE_NEW_FEATURE=false
VUE_APP_SHOW_EXPERIMENTAL=false

# 端口
VUE_APP_PORT=8082
VUE_APP_OUTPUT_DIR=dist-test

# 测试时禁用真实请求
VUE_APP_API_TIMEOUT=5000
VUE_APP_UPLOAD_TIMEOUT=10000
