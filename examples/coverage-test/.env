# 默认 (所有环境都会加载)
NODE_ENV=development
VUE_APP_TITLE=Vue2 覆盖率测试项目 (默认)
VUE_APP_VERSION=1.0.0
VUE_APP_LANGUAGE=zh-CN

# 模块开关
VUE_APP_USE_CDN=false
VUE_APP_USE_MOCK=true
VUE_APP_USE_ERUDA=true
VUE_APP_USE_VCONSOLE=true

# 通用变量
VUE_APP_API_BASE=/api
VUE_APP_UPLOAD_BASE=/upload
VUE_APP_PUBLIC_PATH=/
VUE_APP_PORT=8080
