{
  "name": "vue2-coverage-test-project",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 2 全场景代码覆盖率测试项目 (迁移到 Vue 3 的样本)",
  "author": "Mavis <Mavis@MiniMax.ai>",
  "license": "MIT",
  "scripts": {
    "dev": "vue-cli-service serve --mode development --open",
    "start": "npm run dev",
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build --mode production",
    "build:dev": "vue-cli-service build --mode development",
    "build:staging": "vue-cli-service build --mode staging",
    "build:prod": "vue-cli-service build --mode production --report --report-json",
    "lint": "vue-cli-service lint",
    "lint:nofix": "vue-cli-service lint --no-fix",
    "test": "vue-cli-service test:unit",
    "test:unit": "vue-cli-service test:unit --watchAll=false --coverage",
    "test:watch": "vue-cli-service test:unit --watch",
    "test:e2e": "vue-cli-service test:e2e",
    "analyze": "vue-cli-service build --report",
    "svg": "vsvg -s src/icons/svg -t src/icons/components",
    "new": "plop",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "commit": "git-cz",
    "release": "standard-version",
    "postinstall": "node scripts/postinstall.js || true"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{js,vue,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,less}": [
      "stylelint --fix"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "vue": "2.7.16",
    "vue-router": "3.6.5",
    "vuex": "3.6.2",
    "axios": "0.27.2",
    "element-ui": "2.15.14",
    "ant-design-vue": "1.7.8",
    "@ant-design/icons-vue": "6.1.0",
    "vue-i18n": "8.28.2",
    "vue-class-component": "7.2.6",
    "vue-property-decorator": "9.1.2",
    "vuex-class": "0.3.2",
    "vuex-persistedstate": "4.1.0",
    "vuex-module-decorators": "1.0.1",
    "echarts": "4.9.0",
    "vue-echarts": "4.1.0",
    "vxe-table": "3.6.16",
    "xe-utils": "3.5.4",
    "vue-cropper": "1.0.3",
    "vue-image-crop-upload": "3.0.0",
    "sortablejs": "1.15.0",
    "vuedraggable": "2.24.3",
    "vue-draggable-next": "2.1.1",
    "wangeditor": "4.7.15",
    "tinymce": "5.10.9",
    "vue-tinymce-editor": "3.0.1",
    "nprogress": "0.2.0",
    "js-cookie": "3.0.5",
    "js-md5": "0.8.3",
    "jsencrypt": "3.3.2",
    "moment": "2.30.1",
    "dayjs": "1.11.13",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "uuid": "9.0.1",
    "nanoid": "5.0.7",
    "path-browserify": "1.0.1",
    "clipboard": "2.0.11",
    "vue-clipboard2": "0.3.3",
    "screenfull": "6.0.2",
    "file-saver": "2.0.5",
    "xlsx": "0.18.5",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "qrcodejs2": "0.0.2",
    "vue-qr": "4.0.9",
    "normalize.css": "8.0.1",
    "tailwindcss": "2.2.19",
    "animate.css": "4.1.1",
    "nprogress": "0.2.0",
    "vue-axios": "3.5.2",
    "axios-retry": "3.5.1",
    "vue-echarts": "4.1.0",
    "core-js": "3.38.1",
    "webpack-style-loader": "0.0.1-security",
    "babel-polyfill": "6.26.0",
    "babel-runtime": "6.26.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.5.19",
    "@vue/cli-plugin-router": "4.5.19",
    "@vue/cli-plugin-vuex": "4.5.19",
    "@vue/cli-plugin-eslint": "4.5.19",
    "@vue/cli-plugin-unit-jest": "4.5.19",
    "@vue/cli-plugin-e2e-cypress": "4.5.19",
    "@vue/cli-service": "4.5.19",
    "@vue/cli-plugin-typescript": "4.5.19",
    "@vue/eslint-config-standard": "7.0.0",
    "@vue/eslint-config-typescript": "10.0.0",
    "@vue/test-utils": "1.3.6",
    "@types/vue": "2.0.0",
    "@types/vue-router": "2.0.0",
    "@types/vuex": "2.0.0",
    "@types/node": "20.14.10",
    "@types/lodash": "4.17.6",
    "@types/moment": "2.13.0",
    "typescript": "4.9.5",
    "vue-template-compiler": "2.7.16",
    "babel-core": "7.0.0-bridge.0",
    "@babel/core": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "@babel/preset-typescript": "7.24.7",
    "babel-loader": "8.3.0",
    "ts-loader": "9.5.1",
    "sass": "1.77.8",
    "sass-loader": "10.1.1",
    "less": "4.2.0",
    "less-loader": "7.3.0",
    "postcss": "8.4.40",
    "postcss-loader": "6.2.1",
    "autoprefixer": "10.4.19",
    "postcss-px-to-viewport": "1.1.1",
    "postcss-import": "14.1.0",
    "eslint": "7.32.0",
    "eslint-plugin-vue": "7.20.0",
    "eslint-plugin-typescript": "0.14.0",
    "@typescript-eslint/parser": "5.62.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "prettier": "2.8.8",
    "stylelint": "13.13.1",
    "stylelint-config-standard": "22.0.0",
    "stylelint-config-prettier": "6.0.0",
    "husky": "7.0.4",
    "lint-staged": "11.2.6",
    "commitizen": "4.3.0",
    "cz-customizable": "7.0.0",
    "@commitlint/cli": "17.8.0",
    "@commitlint/config-conventional": "17.8.0",
    "standard-version": "9.5.0",
    "webpack-bundle-analyzer": "4.10.2",
    "plop": "3.1.2",
    "vsvg": "1.4.1",
    "chalk": "4.1.2",
    "rimraf": "3.0.2",
    "cross-env": "7.0.3",
    "compression-webpack-plugin": "9.1.2",
    "terser-webpack-plugin": "5.3.10",
    "jest": "27.5.1",
    "ts-jest": "29.2.2",
    "vue-jest": "3.0.7",
    "cypress": "10.3.0",
    "mockjs": "1.1.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "pnpm": ">=6.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "commitlint -E GIT_PARAMS"
  }
}
