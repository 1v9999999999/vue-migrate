# local (本地) 环境 - gitignore, 不提交
# 复制此文件为 .env.local, 修改其中的值
NODE_ENV=development
VUE_APP_ENV=local
VUE_APP_TITLE=Vue2 覆盖率测试项目 (本地)

# 个人本地 API (覆盖 .env.development)
VUE_APP_API_BASE=/api
VUE_APP_PROXY_TARGET=http://192.168.1.100:3000
VUE_APP_WS_URL=ws://192.168.1.100:3000/ws

# 个人本地第三方 key
VUE_APP_GA_ID=
VUE_APP_SENTRY_DSN=
VUE_APP_BAIDU_MAP_AK=

# 调试
VUE_APP_DEBUG=true
VUE_APP_LOG_LEVEL=verbose
VUE_APP_VCONSOLE=true
VUE_APP_ERUDA=true
VUE_APP_USE_MOCK=false
