{
  "name": "@vue-migrate/sample-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Collects real Vue 2 repositories from GitHub to seed the migration test sample library.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "vue-migrate-collect": "src/index.ts"
  },
  "scripts": {
    "collect": "tsx src/index.ts collect",
    "classify": "tsx src/index.ts classify",
    "test": "tsx --test src/__tests__/classify.test.ts"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "commander": "^12.1.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@types/extract-zip": "^2.0.0",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
