    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "vue-codemod": "^0.0.5"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
