function analyzeValueString(s: string): { kind: 'ref' | 'reactive'; typeStr: string } {

  const trimmed = s.trim()

  if (trimmed === 'null') return { kind: 'ref', typeStr: 'null' }

  if (trimmed === 'true' || trimmed === 'false') return { kind: 'ref', typeStr: 'boolean' }

  if (/^-?\d+(\.\d+)?$/.test(trimmed)) return { kind: 'ref', typeStr: 'number' }

  if (/^['"`].*['"`]$/.test(trimmed)) return { kind: 'ref', typeStr: 'string' }

  if (trimmed.startsWith('[')) {

