/** 把函??方法/计算/生命周期 函数体重新缩进到 `spaces` 空格

 *  - 假设 body ??`{...}` 内部（不含外层大括号?? *  - 所有非空行 strip baseIndent 后加 `spaces` 空格

 *  - 自动剥除首尾空行（不影响内容缩进计算?? */

function indentBlock(body: string, spaces: number): string {

  let lines = body.split('\n')

  if (lines.length === 0) return body

  // 剥除首尾空行
  while (lines.length > 0 && lines[0].trim() === '') lines.shift()

  while (lines.length > 0 && lines[lines.length - 1].trim() === '') lines.pop()

  if (lines.length === 0) return ''

  // 找最小缩
  let baseIndent = Infinity

  for (const l of lines) {

    const m = /^(\s*)/.exec(l)

    if (m) baseIndent = Math.min(baseIndent, m[1].length)

  }

  if (!isFinite(baseIndent)) baseIndent = 0

  return lines

    .map((l) => {

      if (l.trim() === '') return ''

      return ' '.repeat(spaces) + l.substring(baseIndent)

    })

    .join('\n')

}

/** 把多??value（数??对象）重新格式化

