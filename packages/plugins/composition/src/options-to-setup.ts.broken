 */

function reindentValue(value: string, spaces: number): string {

  const lines = value.split('\n')

  if (lines.length <= 1) return value

  // 找内部行的最小缩进（仅看 i in [1, n-2] 且非空）
  const innerLines = lines

    .map((l, i) => ({ l, i }))

    .filter(({ l, i }) => i > 0 && i < lines.length - 1 && l.trim() !== '')

  let baseIndent = 0

  if (innerLines.length > 0) {

    baseIndent = Infinity

    for (const { l } of innerLines) {

      const m = /^(\s*)/.exec(l)

      if (m) baseIndent = Math.min(baseIndent, m[1].length)

    }

    if (!isFinite(baseIndent)) baseIndent = 0

  }

  return lines

    .map((l, i) => {

      if (l.trim() === '') return ''

      const m = /^(\s*)/.exec(l)

      const origIndent = m ? m[1].length : 0

      if (i === 0) {

        // 开括号：放??spaces 缩进
  return ' '.repeat(spaces) + l.trim()

      }

      if (i === lines.length - 1) {

        // 闭括号：放在 spaces 缩进
  return ' '.repeat(spaces) + l.trim()

      }

      // 内部：保持相对关
  const relative = origIndent - baseIndent

      return ' '.repeat(Math.max(0, spaces + 2 + relative)) + l.trim()

    })

    .join('\n')

}

