/** 替换 this.$watch('key', handler, opts?) ??watch(source, handler, opts?) */

function replaceThisWatch(s: string, data: DataResult, result: OptionsToSetupResult): string {

  const re = /\bthis\.\$watch\s*\(\s*('[^']*'|"[^"]*"|[\w.$]+)\s*,\s*/g

  if (!re.test(s)) return s

  re.lastIndex = 0

  result.vueImports.add('watch')

  result.reviewItems.push(

    'this.$watch 已替换为 watch()。注意：??$watch 在组件实例上，返??unwatch 句柄；新??watch 默认??setup 同步注册',

  )

  let out = ''

  let last = 0

  const re2 = /\bthis\.\$watch\s*\(\s*('[^']*'|"[^"]*"|[\w.$]+)\s*,\s*/g

  let m: RegExpExecArray | null

  while ((m = re2.exec(s))) {

    out += s.substring(last, m.index)

    const source = m[1]

    // 把字符串 key 转换为对应的 ref/reactive
  let replacedSource: string

    if (source.startsWith("'") || source.startsWith('"')) {

      const key = source.slice(1, -1)

      const keyMain = key.split('.')[0]

      const field = data.fields.find((f) => f.name === keyMain)

      if (field) {

        const ref = field.kind === 'ref' ? `${field.name}.value` : field.name

        if (key.includes('.')) {

          replacedSource = `() => ${ref}.${key.split('.').slice(1).join('.')}`

        } else {

          replacedSource = ref

          result.reviewItems.push(`this.$watch('${key}') 已转换为 ref??{ref}`)

        }

      } else {

        replacedSource = source

        result.reviewItems.push(

          `this.$watch('${key}') 字符??key，Vue 3 watch 不支持字符串 key，请改用 ref ??getter。`,

        )

      }

    } else {

      replacedSource = source.replace(/^this\./, '')

    }

    out += `watch(${replacedSource}, `

    last = m.index + m[0].length

  }

  out += s.substring(last)

  return out

}

