function findExportDefaultBlock(

  scriptText: string,

): { start: number; end: number; objStart: number; objEnd: number } | null {

  const re = /export\s+default\s*/g

  const m = re.exec(scriptText)

  if (!m) return null

  let i = m.index + m[0].length

  while (i < scriptText.length && /\s/.test(scriptText[i])) i++

  if (scriptText[i] !== '{') return null

  const objStart = i

